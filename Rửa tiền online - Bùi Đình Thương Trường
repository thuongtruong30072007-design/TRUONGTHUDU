</style>

<script>
// Tổng hợp hiệu ứng âm thanh phát bằng Web Audio API
function playSound(type) {
    try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        
        if (type === 'click') {
            // Tiếng Click nút ấn hiện đại
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(600, ctx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(1200, ctx.currentTime + 0.08);
            gain.gain.setValueAtTime(0.3, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.08);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + 0.08);
        } else if (type === 'success') {
            // Hợp âm Chime ăn mừng tăng trưởng tài sản
            const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
            notes.forEach((freq, idx) => {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.value = freq;
                gain.gain.setValueAtTime(0.15, ctx.currentTime + idx * 0.06);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + idx * 0.06 + 0.3);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start(ctx.currentTime + idx * 0.06);
                osc.stop(ctx.currentTime + idx * 0.06 + 0.3);
            });
        }
    } catch(e) { console.log('Audio error:', e); }
}
</script>
"""

# 3. Widget nhập liệu
p_input = widgets.FloatText(value=100000000, description='Vốn gốc (VND):', layout=widgets.Layout(width='320px'))
r_input = widgets.FloatSlider(value=8.5, min=0.1, max=30.0, step=0.1, description='Lãi (%/năm):', layout=widgets.Layout(width='400px'))
t_input = widgets.IntSlider(value=15, min=1, max=40, step=1, description='Thời gian (Năm):', layout=widgets.Layout(width='400px'))
n_input = widgets.Dropdown(
    options=[('Hàng năm (1 lần/năm)', 1), ('Hàng quý (4 lần/năm)', 4), ('Hàng tháng (12 lần/năm)', 12)],
    value=1,
    description='Ghép lãi:',
    layout=widgets.Layout(width='350px')
)

button = widgets.Button(
    description="🚀 TÍNH TOÁN & KÍCH HOẠT LÃI KÉP", 
    button_style='primary',
    layout=widgets.Layout(width='360px', height='48px')
)
button.add_class('btn-calc')
output = widgets.Output()

# 4. Hàm xử lý dữ liệu và vẽ giao diện
def calculate(b):
    P = p_input.value
    r = r_input.value / 100
    t = t_input.value
    n = n_input.value

    years = list(range(0, t + 1))
    simple_interest = [P * (1 + r * y) for y in years]
    compound_interest = [P * ((1 + r / n) ** (n * y)) for y in years]
    
    val_simple = simple_interest[-1]
    val_compound = compound_interest[-1]
    diff = val_compound - val_simple

    with output:
        clear_output(wait=True)
        
        # Kích hoạt âm thanh Success/Chime bằng JS
        display(HTML("<script>playSound('success');</script>"))
        
        # 1. Thẻ KPI Dashboard rực rỡ
        kpi_html = f"""
        <div class="kpi-container">
            <div class="kpi-card simple">
                <div class="kpi-title">💎 Lãi Đơn (Cuối kỳ)</div>
                <div class="kpi-value">{val_simple:,.0f} đ</div>
                <div class="kpi-sub">Tổng lãi: +{val_simple-P:,.0f} đ</div>
            </div>
            <div class="kpi-card compound">
                <div class="kpi-title">🚀 Lãi Kép (Cuối kỳ)</div>
                <div class="kpi-value">{val_compound:,.0f} đ</div>
                <div class="kpi-sub">Tổng lãi: +{val_compound-P:,.0f} đ</div>
            </div>
            <div class="kpi-card diff">
                <div class="kpi-title">🔥 Bùng Nổ Lãi Kép</div>
                <div class="kpi-value">+{diff:,.0f} đ</div>
                <div class="kpi-sub">Chênh lệch vượt trội nhờ sức mạnh thời gian</div>
            </div>
        </div>
        """
        display(HTML(kpi_html))

        # 2. Biểu đồ Plotly chủ đề Neon/Dark Vibrant
        fig = go.Figure()
        
        # Đường Lãi Đơn (Cyan/Neon Blue)
        fig.add_trace(go.Scatter(
            x=years, y=simple_interest,
            mode='lines+markers', name='Lãi Đơn',
            line=dict(color='#00F0FF', width=3, dash='dash'),
            marker=dict(size=7, color='#00F0FF'),
            hovertemplate='Năm %{x}: %{y:,.0f} VND'
        ))
        
        # Đường Lãi Kép (Hot Pink/Neon Gold Gradient)
        fig.add_trace(go.Scatter(
            x=years, y=compound_interest,
            mode='lines+markers', name='Lãi Kép (Bùng nổ)',
            line=dict(color='#FF007A', width=4),
            marker=dict(size=8, color='#FFD700'),
            hovertemplate='Năm %{x}: %{y:,.0f} VND'
        ))

        fig.update_layout(
            title=dict(
                text=f'<b>SỨC MẠNH TĂNG TRƯỞNG TÀI SẢN ({t} NĂM)</b>',
                font=dict(size=18, color='#FFFFFF')
            ),
            xaxis=dict(title='Thời gian (Năm)', gridcolor='#2D3748', titlefont=dict(color='#A0AEC0'), tickfont=dict(color='#E2E8F0')),
            yaxis=dict(title='Tổng Tài Sản (VND)', gridcolor='#2D3748', titlefont=dict(color='#A0AEC0'), tickfont=dict(color='#E2E8F0')),
            paper_bgcolor='#111827',
            plot_bgcolor='#1F2937',
            height=460,
            hovermode="x unified",
            margin=dict(l=40, r=40, t=60, b=40),
            legend=dict(
                orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1,
                font=dict(color='#FFFFFF', size=12)
            )
        )
        fig.show()

        # 3. Bảng dữ liệu chi tiết
        df = pd.DataFrame({
            'Năm': years,
            'Vốn gốc (VND)': [P] * len(years),
            'Lãi đơn (VND)': simple_interest,
            'Lãi kép (VND)': compound_interest,
            'Chênh lệch Lãi Kép (VND)': [c - s for s, c in zip(simple_interest, compound_interest)]
        })
        
        styled_df = df.style.format({
            'Vốn gốc (VND)': '{:,.0f}',
            'Lãi đơn (VND)': '{:,.0f}', 
            'Lãi kép (VND)': '{:,.0f}', 
            'Chênh lệch Lãi Kép (VND)': '{:,.0f}'
        }).background_gradient(subset=['Chênh lệch Lãi Kép (VND)'], cmap='PuRd')
        
        display(styled_df)

# Gắn sự kiện Click nút
def on_btn_click(b):
    calculate(b)

button.on_click(on_btn_click)

